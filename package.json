{
  "name": "cadenza",
  "type": "module",
  "version": "0.4.12",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "description": "shadcn-flavoured component library built on Base UI",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "eslint",
    "fix": "eslint --fix",
    "test": "vitest",
    "typecheck": "tsc && pnpm -r run typecheck",
    "release": "bumpp --no-verify",
    "prepare": "git config core.hooksPath .githooks && simple-git-hooks && skills-npm"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/ni": "catalog:cli",
    "@eslint-react/eslint-plugin": "catalog:cli",
    "@testing-library/react": "catalog:testing",
    "@testing-library/user-event": "catalog:testing",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "@vitejs/plugin-react": "catalog:testing",
    "bumpp": "catalog:cli",
    "eslint": "catalog:cli",
    "eslint-plugin-better-tailwindcss": "catalog:cli",
    "eslint-plugin-react-hooks": "catalog:cli",
    "eslint-plugin-react-refresh": "catalog:cli",
    "jsdom": "catalog:testing",
    "nano-staged": "catalog:cli",
    "publint": "catalog:cli",
    "simple-git-hooks": "catalog:cli",
    "skills-npm": "catalog:cli",
    "tailwindcss": "catalog:ui",
    "tsdown": "catalog:cli",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "vitest": "catalog:testing"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && npx nano-staged"
  },
  "nano-staged": {
    "*": "eslint --fix --no-error-on-unmatched-pattern"
  }
}
