{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // The vendored-sources test reads the filesystem. Ambient @types discovery does
    // not reach node's under pnpm's isolated layout, so name it.
    "types": ["node"]
  },
  "include": ["src", "test", "tsdown.config.ts"],
  // Upstream routes a function-capable className (Base UI's, typed
  // `string | (state) => string`) onto a plain <div>, which cn's
  // honest return type rightly rejects — but these are byte-pinned vendored
  // source, so the fix cannot land here. Neither is promoted or reachable from
  // src/index.ts, so nothing ships unchecked. Promoting one later means forking
  // it out of primitives first.
  "exclude": ["src/primitives/accordion.tsx", "src/primitives/combobox.tsx"]
}
