{
  "name": "@gedatou/cadenza-ui",
  "type": "module",
  "version": "0.0.0",
  "description": "Accessible React components \u2014 React Aria behaviour, shadcn aria-nova styling",
  "license": "MIT",
  "homepage": "https://github.com/GGGLHHH/cadenza#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GGGLHHH/cadenza.git",
    "directory": "packages/ui"
  },
  "bugs": "https://github.com/GGGLHHH/cadenza/issues",
  "keywords": [
    "react",
    "react-aria",
    "shadcn",
    "tailwindcss",
    "component-library",
    "accessibility"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "imports": {
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#primitives/*": "./src/primitives/*.tsx"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4",
    "tw-animate-css": ">=1"
  },
  "dependencies": {
    "@gedatou/cadenza-utils": "workspace:*",
    "@tabler/icons-react": "catalog:ui",
    "@tanstack/react-virtual": "catalog:ui",
    "class-variance-authority": "catalog:ui",
    "clsx": "catalog:ui",
    "react-aria-components": "catalog:ui",
    "tailwind-merge": "catalog:ui"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:ui",
    "@react-types/shared": "catalog:ui",
    "@shadcn/react": "catalog:ui",
    "@types/node": "catalog:types",
    "embla-carousel-react": "catalog:ui",
    "input-otp": "catalog:ui",
    "next-themes": "catalog:ui",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "react-resizable-panels": "catalog:ui",
    "recharts": "catalog:ui",
    "sonner": "catalog:ui",
    "tailwindcss": "catalog:ui",
    "tsdown": "catalog:cli",
    "tw-animate-css": "catalog:ui",
    "typescript": "catalog:cli"
  }
}
