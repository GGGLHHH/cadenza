{
  "name": "@cadenza/ui",
  "type": "module",
  "version": "0.0.0",
  "description": "Accessible React components — React Aria behaviour, shadcn aria-nova styling",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "shadcn": ">=4",
    "tailwindcss": ">=4",
    "tw-animate-css": ">=1"
  },
  "dependencies": {
    "class-variance-authority": "catalog:ui",
    "clsx": "catalog:ui",
    "lucide-react": "catalog:ui",
    "react-aria-components": "catalog:ui",
    "tailwind-merge": "catalog:ui"
  },
  "devDependencies": {
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "shadcn": "catalog:ui",
    "tailwindcss": "catalog:ui",
    "tsdown": "catalog:cli",
    "tw-animate-css": "catalog:ui",
    "typescript": "catalog:cli"
  }
}
