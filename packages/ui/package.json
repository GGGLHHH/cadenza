{
  "name": "@gedatou/cadenza-ui",
  "type": "module",
  "version": "0.0.0",
  "description": "Accessible React components — React Aria behaviour, shadcn aria-nova styling",
  "license": "MIT",
  "homepage": "https://github.com/GGGLHHH/cadenza#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GGGLHHH/cadenza.git",
    "directory": "packages/ui"
  },
  "bugs": "https://github.com/GGGLHHH/cadenza/issues",
  "keywords": [
    "react",
    "react-aria",
    "shadcn",
    "tailwindcss",
    "component-library",
    "accessibility"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4",
    "tw-animate-css": ">=1"
  },
  "dependencies": {
    "@tabler/icons-react": "catalog:ui",
    "class-variance-authority": "catalog:ui",
    "clsx": "catalog:ui",
    "react-aria-components": "catalog:ui",
    "tailwind-merge": "catalog:ui"
  },
  "devDependencies": {
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "tailwindcss": "catalog:ui",
    "tsdown": "catalog:cli",
    "tw-animate-css": "catalog:ui",
    "typescript": "catalog:cli"
  }
}
